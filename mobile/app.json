{
  "expo": {
    "name": "WellGreen ERP",
    "slug": "wellgreen-erp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "wellgreen",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.wellgreen.erp" },
    "android": { "package": "com.wellgreen.erp" },
    "plugins": ["expo-router"],
    "extra": {
      "apiBase": "http://localhost:8000",
      "comment": "Override per environment via EXPO_PUBLIC_API_BASE or by editing this value. On a real device use the host LAN IP, not localhost."
    }
  }
}
