# Copy to deploy/rclone.conf and fill in ONE backend.
# Then set BACKUP_REMOTE_TARGET=<remote-name>:<bucket-or-path> in .env.
#
# Generate from scratch interactively with:
#   docker run --rm -it -v $(pwd)/deploy:/config rclone/rclone:latest \
#     config --config /config/rclone.conf

# ──────── AWS S3 ────────────────────────────────────────────────────
[s3]
type = s3
provider = AWS
access_key_id = AKIA...
secret_access_key = ...
region = ap-northeast-2
# Then: BACKUP_REMOTE_TARGET=s3:my-erp-backups

# ──────── Synology NAS (SMB) ───────────────────────────────────────
# [nas]
# type = smb
# host = 192.168.1.50
# user = backup
# pass = <use 'rclone obscure' for this value>
# domain = WORKGROUP
# Then: BACKUP_REMOTE_TARGET=nas:erp-backups

# ──────── Synology / Generic SFTP ──────────────────────────────────
# [sftp]
# type = sftp
# host = nas.internal
# user = backup
# port = 22
# key_file = /config/rclone/ssh-key
# Then: BACKUP_REMOTE_TARGET=sftp:erp-backups

# ──────── Google Cloud Storage ─────────────────────────────────────
# [gcs]
# type = google cloud storage
# service_account_file = /config/rclone/gcs-sa.json
# project_number = 123456789
# Then: BACKUP_REMOTE_TARGET=gcs:my-erp-backups

# ──────── BackBlaze B2 (저렴) ──────────────────────────────────────
# [b2]
# type = b2
# account = <key-id>
# key = <application-key>
# Then: BACKUP_REMOTE_TARGET=b2:erp-backups
