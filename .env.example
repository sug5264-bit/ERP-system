# Copy to .env (gitignored) for `docker compose up`.
# Generate strong secrets with: ./scripts/gen-secrets.sh

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-pg-password
POSTGRES_DB=erp

# ─── Backend ─────────────────────────────────────────────────────────────
# Must be ≥ 32 random bytes. NEVER use the placeholder in production.
JWT_SECRET=change-me-32-bytes-or-more-randomly-generated-secret
ENVIRONMENT=production
CORS_ORIGINS=["https://erp.example.com"]
SEED_DEMO_USERS=0
AUTO_CREATE_TABLES=0

# Optional integrations (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp.example.com/api/auth/oauth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@erp.example.com
SMTP_USE_TLS=true

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

SLACK_WEBHOOK_URL=

# Scheduler runs MRP/depreciation/escalation jobs on a cron schedule.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
RATE_LIMIT_ENABLED=true

# ─── Frontend (baked at build time, not runtime) ─────────────────────────
NEXT_PUBLIC_API_BASE=https://erp.example.com

# ─── Reverse proxy (nginx config) ────────────────────────────────────────
PUBLIC_DOMAIN=erp.example.com
LETSENCRYPT_EMAIL=admin@example.com
